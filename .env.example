# ---------------------------------------------------------------------------
# PlacidWay -> Facebook daily post (n8n). Copy to .env and fill in.
# n8n reads these at start-up; restart n8n after changing them.
# ---------------------------------------------------------------------------

# --- n8n itself ---------------------------------------------------------------
N8N_BLOCK_ENV_ACCESS_IN_NODE=false      # REQUIRED: lets Code nodes / expressions read the variables below
GENERIC_TIMEZONE=Asia/Jakarta           # schedule trigger (09:00) and weekday rotation use this zone
TZ=Asia/Jakarta
WEBHOOK_URL=http://localhost:5678/      # public base URL; approve/reject links are built from it
# N8N_ENCRYPTION_KEY=...                # set once in production

# --- Safety switches ----------------------------------------------------------
DRY_RUN=true                            # true = build everything, send nothing to Facebook
APPROVAL_MODE=false                     # true = send draft to reviewer, publish only after "approve"
APPROVAL_TIMEOUT_HOURS=24               # no decision within this window -> run logged as "expired"

# --- Source (PlacidWay) -------------------------------------------------------
PW_BASE_URL=https://www.placidway.com   # where pages are fetched from (canonical URLs always stay www.placidway.com)
PW_USER_AGENT="PlacidWayFBDemoBot/1.0 (+assessment demo; contact you@example.com)"
PW_MIN_DELAY_SECONDS=1.1                # >= 1 request/second; robots.txt Crawl-delay wins if larger
CONTENT_ROTATION=article,package,answer,article,package,answer,article   # Mon..Sun
CONTENT_TYPE_OVERRIDE=                  # force article|package|answer for every run (testing)
CANDIDATE_WINDOW=30                     # how many newest unposted items are considered
VARIETY_LOOKBACK=3                      # avoid repeating the treatment category of the last N posts
SKIP_URL_PATTERN=                       # optional brand-safety regex, e.g. autism|terminal
IMAGE_VARIANT=original                  # original (raw CDN file) | og (PlacidWay 1200x630 social crop) | none (link post)
DEDUPE_INCLUDE_DRY_RUN=true             # dry-run posts also count as "posted" (so repeated tests rotate items)

# --- LLM (writer + reviewer) --------------------------------------------------
LLM_PROVIDER=openai                     # openai (any OpenAI-compatible API) | anthropic
LLM_BASE_URL=https://api.openai.com/v1  # e.g. https://openrouter.ai/api/v1, https://api.groq.com/openai/v1, https://api.anthropic.com
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini                   # anthropic example: claude-sonnet-4-5
LLM_REVIEW_MODEL=                       # optional different model for the guardrail review (defaults to LLM_MODEL)
LLM_TEMPERATURE=0.4
LLM_JSON_MODE=true                      # sends response_format=json_object (set false if your provider rejects it)
ALLOW_PRICES=false                      # false = posts never mention prices; true = only exact figures from the page
MAX_REWRITES=1                          # guardrail failure -> rewrite once with the issues, then block

# --- Facebook ---------------------------------------------------------------
FB_PAGE_ID=957899504078846              # NeuPix test page
FB_PAGE_NAME=NeuPix
FB_ALLOWED_PAGE_IDS=957899504078846     # hard allow-list: the workflow refuses to publish anywhere else
FB_PAGE_TOKEN=                          # long-lived PAGE access token (README section 5)
FB_GRAPH_VERSION=v24.0
FB_GRAPH_BASE_URL=https://graph.facebook.com
FB_SCHEDULE_DELAY_MINUTES=0             # 0 = publish now; e.g. 480 = schedule 8 h after the run (min 11, max 30 days)

# --- Notifications (Slack-compatible incoming webhooks) -----------------------
ALERT_WEBHOOK_URL=                      # failures land here
REVIEW_WEBHOOK_URL=                     # approval requests (defaults to ALERT_WEBHOOK_URL)
WEBHOOK_FORMAT=slack                    # slack ({"text": ...}) | generic (structured JSON for Make/Zapier/Telegram relays)
RUN_TOKEN=                              # optional shared secret for POST /webhook/placidway-run (header x-run-token)
